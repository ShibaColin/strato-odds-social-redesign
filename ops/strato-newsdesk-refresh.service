[Unit]
Description=STRATO Newsdesk cloud update and Telegram notifications
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=-/etc/strato-newsdesk/newsdesk.env
Type=oneshot
DynamicUser=yes
WorkingDirectory=/opt/strato-newsdesk
ExecStart=/usr/bin/python3 -B /opt/strato-newsdesk/newsdesk_refresh.py
LoadCredential=sites-service-token:/etc/strato-newsdesk/sites-service-token
LoadCredential=metals-ingest-key:/etc/strato-newsdesk/metals-ingest-key
StateDirectory=strato-newsdesk
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=180
MemoryMax=128M
CPUQuota=20%
