[Unit]
Description=STRATO Newsdesk local writing and media
After=network-online.target ollama.service
Wants=network-online.target
[Service]
EnvironmentFile=-/etc/strato-newsdesk/newsdesk.env
Type=oneshot
DynamicUser=yes
WorkingDirectory=/opt/strato-newsdesk
ExecStart=/usr/bin/python3 -B /opt/strato-newsdesk/newsdesk_editorial.py
LoadCredential=sites-service-token:/etc/strato-newsdesk/sites-service-token
LoadCredential=metals-ingest-key:/etc/strato-newsdesk/metals-ingest-key
StateDirectory=strato-newsdesk-editorial
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=240
MemoryMax=512M
CPUQuota=100%
Nice=10
